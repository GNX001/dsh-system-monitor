# Dependencies are dev-only; the plugin itself ships with none.
node_modules/

# Local npm cache used when the default cache directory is not writable.
.npm-cache/

# Build/QA scratch
*.log

# Commit-message and ad-hoc scratch files. `git add -A` before composing a commit
# message can otherwise pick these up, which is exactly how `_msg.txt` once
# reached the published tree.
_*

# OS noise
.DS_Store
Thumbs.db
